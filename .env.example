# API Configuration
# For local development with PHP server: leave empty or set to /api
# For local development with Netlify Functions: set to empty (uses local functions)
# For production Netlify deployment: leave empty (uses deployed functions)
VITE_API_BASE_URL=

# Netlify Environment Variables (set in Netlify dashboard)
# NETLIFY_BLOBS_SECRET_KEY=your-secret-key
